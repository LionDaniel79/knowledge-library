DATABASE_URL=
DATABASE_URL_UNPOOLED=
LIBRARY_APP_ROLE=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
LIBRARY_OWNER_EMAIL=
APP_ORIGIN=http://127.0.0.1:3000

# Optional local folder containing hash-named imported covers.
LIBRARY_IMPORT_ASSET_DIR=
LIBRARY_PDF_ROOT=
LIBRARY_PDF_INDEX=

# Optional private PC link (Tailscale Serve; never public Funnel).
LIBRARY_PC_ORIGIN=
LIBRARY_PC_PRIVATE_CONFIRMED=false

# Opt-in desktop MCP. Dedicated read-only DB role, pinned owner; no HTTP endpoint.
LIBRARY_MCP_ENABLED=false
LIBRARY_MCP_OWNER_ID=
LIBRARY_MCP_DATABASE_URL=

# Local Python with pypdfium2, used only by the local PDF viewer
LIBRARY_PYTHON=""

# Optional library metadata verification; server/local scripts only.
DATA4LIBRARY_KEY=

# Optional outbound PC connection config, stored outside Git.
LIBRARY_WORKER_CONFIG=

# Optional PC-only Zotero credential file protected with Windows DPAPI.
LIBRARY_ZOTERO_CONFIG=
# Existing PowerShell 7 runtime; no system execution-policy changes.
LIBRARY_POWERSHELL=

# Optional explicit GPT assistance: PC environment only, never NEXT_PUBLIC or cloud.
OPENAI_API_KEY=
LIBRARY_ASSIST_MODEL=gpt-6-luna
LIBRARY_ASSIST_PRICING_VERSION=openai-gpt-6-luna-standard-2026-10-13
GOOGLE_BOOKS_API_KEY=

# Shared local collector ledger; keep the same absolute path across runs/callers.
# CATALOG_API_USAGE_PATH=C:/path/to/private-data/catalog/api-usage.sqlite
DATA4LIBRARY_DAILY_LIMIT=450
CATALOG_CACHE_DIR=
DATA4LIBRARY_IP_REGISTERED=false
GOOGLE_BOOKS_DAILY_LIMIT=450
